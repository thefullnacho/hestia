[Unit]
Description=Hestia — nightly off-box backup (records DB + memories -> hl-relay)
After=network-online.target
Wants=network-online.target
# Page the phone if the push ever fails (install deploy/watchdog/hestia-alert@.service
# as a USER unit on this box) — a broken backup must never be silent again.
OnFailure=hestia-alert@%n.service

[Service]
Type=oneshot
# hl-relay LAN IP + user — set once; LAN reaches the real sshd, bypassing Tailscale SSH
# check-mode. Both REQUIRED: the script refuses to run with either missing.
Environment=HESTIA_BACKUP_HOST=RELAY_LAN_IP
Environment=HESTIA_BACKUP_USER=RELAY_USER
ExecStart=%h/hestia/deploy/backup/hestia-backup.sh
