[Unit]
Description=Hestia — nightly house journal + almanac refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hestia/brain
ExecStart=%h/.local/bin/uv run --project %h/hestia/brain python %h/hestia/brain/journal.py
ExecStart=%h/.local/bin/uv run --project %h/hestia/brain python %h/hestia/brain/almanac.py
