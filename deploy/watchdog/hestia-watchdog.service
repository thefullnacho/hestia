[Unit]
Description=Hestia — off-site watchdog (is the house alive?)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=youruser
Environment=HESTIA_HEALTH_URL=http://BRAIN_TAILNET_IP:8730/health
Environment=HESTIA_NTFY_URL=https://ntfy.sh/CHANGE-ME-RANDOM-TOPIC
# DNS probe. Point at the household resolver's tailnet address, not its LAN address, since
# this runs off-site. Leave HESTIA_DNS_SERVER unset to skip the DNS checks entirely.
Environment=HESTIA_DNS_SERVER=RESOLVER_TAILNET_IP
Environment=HESTIA_DNS_PROBE_NAME=github.com
# A domain your blocklists are expected to block. Unset to skip the filtering check.
# Pick one that is stable across list updates and that you do not mind querying every 5min.
Environment=HESTIA_DNS_BLOCKED_NAME=CHANGE-ME-A-DOMAIN-YOUR-LISTS-BLOCK
# HA critical-entity probe: pages when a listed entity reads unavailable/unknown for
# HESTIA_HA_BAD_RUNS consecutive runs (default 2, ~10min, so HA restarts stay silent), and
# when the HA API itself stops answering. Deliberately opt-in: left commented, the script
# skips it and says so in the journal — an unsubstituted placeholder here would page on a
# house that is fine. Token is a long-lived HA access token; keep it out of the repo.
#Environment=HESTIA_HA_URL=http://RELAY_TAILNET_IP:8124
#Environment=HESTIA_HA_TOKEN=CHANGE-ME-LONG-LIVED-HA-TOKEN
#Environment=HESTIA_HA_ENTITIES=assist_satellite.CHANGE_ME update.CHANGE_ME
ExecStart=/home/youruser/hestia-offsite/hestia-watchdog.sh
