# Copy to glance.env on hl-relay and fill in. glance.env is gitignored — this repo is
# public, so real tailnet addresses never get committed (same rule as slskd.env).

# The brain, reachable from hl-relay. Use the GPU box's tailnet IP (stable) rather than a
# MagicDNS name: the container's resolver is Docker's, not the tailnet's.
#   tailscale ip -4    # run on the GPU box
BRAIN=http://100.x.y.z:8730

# hl-relay itself, as the BROWSER should reach it — these become the clickable tiles, so
# they must resolve on the device you're looking at the dashboard from, not inside the
# container. The MagicDNS short name works from any tailnet device.
RELAY=http://hl-relay

# The homestead, for the garden forecast. Matches HESTIA_LAT/HESTIA_LON in the brain's
# weather tool so the tile and the spoken forecast agree.
LAT=41.3311594
LON=-72.154657
WEATHER_LOCATION=Westbrook, Connecticut, United States
