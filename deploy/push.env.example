# Copy to secrets/push.env to let the box send the iPhone app its content-free ping through
# Apple's push service (brain/push.py, SECURITY.md "Phone notifications"). Without it a ping
# is a logged dry run. The .p8 key comes from the Apple developer account (Keys, with Apple
# Push Notifications service enabled) and lives under secrets/, never in the repo.
#
# load order: brain/config.py loads this after hosts.env; a real environment variable
# (e.g. a systemd Environment= line) still overrides it.
# A relative path is read under secrets/
HESTIA_APNS_KEY_FILE=apns/AuthKey_XXXXXXXXXX.p8
HESTIA_APNS_KEY_ID=XXXXXXXXXX
HESTIA_APNS_TEAM_ID=XXXXXXXXXX
HESTIA_APNS_BUNDLE_ID=com.example.hestia
# 1 while the app is a development build (Xcode); its tokens only work on the sandbox host
HESTIA_APNS_SANDBOX=1
# At most one ping per device in this many minutes, unless the app opened since
HESTIA_PUSH_DEBOUNCE_MIN=30
